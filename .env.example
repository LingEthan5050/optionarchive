# Copy to .env and fill in. .env is gitignored (design doc §8).
# The OAuth application must be registered with the `read` scope ONLY (§1).

TT_CLIENT_SECRET=your-oauth-client-secret
TT_REFRESH_TOKEN=your-oauth-refresh-token

# Optional. Defaults shown.
# TT_ENV=production        # or "cert" for the sandbox
# ARCHIVE_DATA_DIR=data

# Dead-man's switch. The job pings this on success; the service alerts you
# when a ping does not arrive. Guards against silent death - the job stops
# running and you notice in March. Unset means unmonitored.
# HEALTHCHECK_URL=https://hc-ping.com/your-uuid-here

# Discord account bot (python -m account_bot). Optional - the archiver never
# reads these, and the installer only schedules the bot when both are set.
# It reuses the TT_ credential above, so it is exactly as read-only.
#   token:     Developer Portal > your application > Bot > Reset Token
#   owner id:  Discord > Settings > Advanced > Developer Mode, then
#              right-click your own name > Copy User ID
#   guild id:  right-click your private server > Copy Server ID. Optional,
#              but without it new slash commands can take an hour to appear.
# DISCORD_BOT_TOKEN=
# DISCORD_OWNER_ID=
# DISCORD_GUILD_ID=
# When the summary (day P/L + option trades) is posted, Eastern.
# SUMMARY_TIMES=10:00,16:00
# Include dollar amounts in the POSTED summary. Off by default because the
# alert channel may be readable by others; /expiring always shows dollars
# to you alone.
# SUMMARY_DOLLARS=false
# Rule-of-thumb alerts: days-to-expiration warnings, and the share of max
# profit at which a short-premium trade gets a take-profit alert.
# ALERT_DTE=28,21
# PROFIT_TARGET=0.50
# Text channel (in DISCORD_GUILD_ID) for alerts and the daily summary.
# Falls back to a DM if it doesn't exist. Anyone who can read it sees them.
# ALERT_CHANNEL=options
