#!/bin/sh
# Blocks commits that would leak credentials.
# Enable with:  git config core.hooksPath .githooks

fail=0

# 1. Never allow .env itself to be staged.
if git diff --cached --name-only | grep -qE '(^|/)\.env($|\.)' ; then
    if ! git diff --cached --name-only | grep -qE '(^|/)\.env\.example$'; then
        echo "BLOCKED: .env is staged. It must never be committed."
        fail=1
    fi
fi

# 2. Refuse staged content that looks like a JWT (tastytrade refresh token).
if git diff --cached -U0 | grep -qE '^\+.*eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\.'; then
    echo "BLOCKED: staged change contains a JWT-shaped string (refresh token?)."
    fail=1
fi

# 3. Refuse a populated TT_ credential assignment.
if git diff --cached -U0 | grep -qE '^\+\s*TT_(CLIENT_SECRET|REFRESH_TOKEN)\s*=\s*\S+' \
   && ! git diff --cached -U0 | grep -qE '^\+\s*TT_(CLIENT_SECRET|REFRESH_TOKEN)\s*=\s*(your-|$)'; then
    echo "BLOCKED: staged change assigns a real value to a TT_ credential."
    fail=1
fi

[ "$fail" -eq 0 ] || echo "Commit aborted. Unstage the offending change."
exit $fail
